{
  "name": "chronocity",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/unit",
    "format:check": "prettier --check src tests/unit tests/e2e *.json *.ts *.js",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "architecture:check": "node scripts/architecture-check.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run architecture:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
