{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/main.tsx",
    "src/app",
    "src/pages",
    "src/modules",
    "src/infrastructure",
    "src/shared",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/unit",
    "tests/e2e"
  ]
}
